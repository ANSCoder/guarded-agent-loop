# Local Ollama setup. Start Ollama and pull the model before running `agent-runtime eval`.
AGENT_PROVIDER=openai
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=qwen3:8b

# Optional: skip a thinking model's reasoning. About 4x faster per run for qwen3:8b on Ollama.
# AGENT_REASONING_EFFORT=none

# Optional: override runtime defaults.
# AGENT_MAX_STEPS=12
# AGENT_TIMEOUT_S=120

# Optional alternatives:
# For a hosted OpenAI-compatible provider, change AGENT_BASE_URL and AGENT_MODEL.
# Set AGENT_API_KEY in your ignored .env only if that provider requires a key.
# For Anthropic instead, set AGENT_PROVIDER=anthropic and ANTHROPIC_API_KEY in your ignored .env.
